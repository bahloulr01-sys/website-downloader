generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id              String           @id @default(uuid())
  userId          String
  name            String
  sourceUrl       String
  status          String           @default("QUEUED")
  cloneMode       String           @default("VISUAL")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs            CloneJob[]
  pages           Page[]
  assets          Asset[]
  browserSessions BrowserSession[]
  exports         Export[]
}

model CloneJob {
  id               String    @id @default(uuid())
  projectId        String
  status           String    @default("QUEUED")
  progress         Int       @default(0)
  currentStep      String?
  pagesDiscovered  Int       @default(0)
  pagesCompleted   Int       @default(0)
  assetsDiscovered Int       @default(0)
  assetsDownloaded Int       @default(0)
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Page {
  id         String   @id @default(uuid())
  projectId  String
  url        String
  path       String
  title      String?
  status     String   @default("PENDING")
  html       String?
  screenshot String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets     Asset[]
}

model Asset {
  id          String   @id @default(uuid())
  projectId   String
  pageId      String?
  originalUrl String
  localPath   String?
  type        String
  mimeType    String?
  size        Int?
  hash        String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
}

model BrowserSession {
  id        String   @id @default(uuid())
  projectId String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  expiresAt DateTime
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Export {
  id          String    @id @default(uuid())
  projectId   String
  type        String
  status      String    @default("PENDING")
  filePath    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
